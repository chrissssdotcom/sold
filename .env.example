# Copy to .env for local development. Never commit real values.
SOLD_ENVIRONMENT=local
NODE_ENV=development

# App traffic goes through PgBouncer (compose: 6432); migrations and the job queue connect directly (5432).
DATABASE_URL=postgres://sold:sold@localhost:6432/sold
DATABASE_MIGRATION_URL=postgres://sold:sold@localhost:5432/sold
DATABASE_POOLER=pgbouncer
# DATABASE_REPLICA_URL=

REDIS_URL=redis://localhost:6379
METRICS_TOKEN=local-metrics-token-1234

# Base64 of 32 random bytes: `openssl rand -base64 32`. Required outside local.
# SOLD_SECRET_KEY=

# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
