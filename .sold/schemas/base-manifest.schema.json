{
  "$id": "urn:sold:schema:base-manifest",
  "title": ".sold/base-manifest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "baseOwned": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "customerOwned": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generated": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": ["schemaVersion", "baseOwned", "customerOwned", "generated"],
  "additionalProperties": false
}
