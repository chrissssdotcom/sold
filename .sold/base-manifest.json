{
  "schemaVersion": 1,
  "description": "Ownership of paths in a Sold repository. Base-owned paths are replaced from upstream by `sold upgrade:plan` and must not be edited in an instance repository outside an upgrade/* branch (`sold drift:check`). Customer-owned paths are never touched by upgrades. Generated paths are rewritten by tooling and ignored by the drift check. Precedence: generated, then baseOwned, then customerOwned; a path in none of them is unowned.",
  "baseOwned": [
    "apps/**",
    "packages/**",
    "upgrades/**",
    "extensions/_template/**",
    "extensions/loyalty-points/**",
    "extensions/reviews/**",
    "extensions/tiktok-social/**",
    "ops/docker/**",
    "ops/grafana/**",
    "ops/k8s/**",
    "ops/loadtests/**",
    "ops/prometheus/**",
    "ops/terraform/modules/**",
    "ops/terraform/profiles/**",
    "ops/terraform/scripts/**",
    "ops/terraform/bootstrap/**",
    "ops/terraform/environments/demo/**",
    "docs/adr/**",
    "docs/runbooks/**",
    "docs/extending/**",
    "docs/*.md",
    ".github/workflows/ci.yml",
    ".github/workflows/env-*.yml",
    ".github/workflows/release.yml",
    ".github/workflows/terraform.yml",
    ".changeset/**",
    ".sold/base-manifest.json",
    ".sold/schemas/**",
    "CHANGELOG.md",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "Dockerfile",
    "docker-compose.yml",
    "package.json",
    "turbo.json",
    "pnpm-workspace.yaml",
    "eslint.config.js",
    "commitlint.config.js",
    ".nvmrc",
    ".npmrc",
    ".prettierrc.json",
    ".prettierignore",
    ".gitignore",
    ".dockerignore",
    ".env.example"
  ],
  "customerOwned": [
    "extensions/**",
    "sold.config.ts",
    "config/**",
    "environments/**",
    "ops/terraform/environments/**",
    "docs/instance/**",
    ".github/workflows/instance-*.yml",
    ".sold/instance.json"
  ],
  "generated": ["pnpm-lock.yaml", ".sold/base-version"]
}
