{
  "uid": "sold-sales-ops",
  "title": "Sales & Operations",
  "tags": [
    "sold",
    "business"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Revenue, last 30 days",
      "description": "Paid, processing, shipped and delivered orders. Per currency: never summed across currencies.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sold-reporting"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sold-reporting"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT currency, sum(total) AS revenue FROM reporting.daily_sales WHERE day >= current_date - 30 GROUP BY currency ORDER BY currency"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Orders, last 30 days",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sold-reporting"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sold-reporting"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COALESCE(sum(orders), 0) AS orders FROM reporting.daily_sales WHERE day >= current_date - 30"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Awaiting payment now",
      "description": "Orders placed in the last 2 days that are still unpaid.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sold-reporting"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sold-reporting"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COALESCE(sum(awaiting_payment), 0) AS awaiting FROM reporting.order_funnel WHERE day >= current_date - 2"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Low or out of stock variants",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sold-reporting"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sold-reporting"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS variants FROM reporting.inventory_health WHERE low_stock"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Daily revenue",
      "description": "Revenue per day and currency.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sold-reporting"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sold-reporting"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT day::timestamp AS time, currency AS metric, total AS value FROM reporting.daily_sales WHERE $__timeFilter(day::timestamp) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Order funnel (orders placed per day)",
      "description": "Placed vs paid vs cancelled, by the day the order was placed.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sold-reporting"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sold-reporting"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT day::timestamp AS time, placed AS value, 'placed' AS metric FROM reporting.order_funnel WHERE $__timeFilter(day::timestamp) ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sold-reporting"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT day::timestamp AS time, paid AS value, 'paid' AS metric FROM reporting.order_funnel WHERE $__timeFilter(day::timestamp) ORDER BY 1"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sold-reporting"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT day::timestamp AS time, cancelled AS value, 'cancelled' AS metric FROM reporting.order_funnel WHERE $__timeFilter(day::timestamp) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "table",
      "title": "Top products, last 30 days",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sold-reporting"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sold-reporting"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT title AS product, currency, units, revenue FROM reporting.top_products_30d ORDER BY revenue DESC LIMIT 15"
