{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["SOLD_TEST_DATABASE_URL", "SOLD_TEST_REDIS_URL"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "SOLD_TEST_DATABASE_URL",
        "SOLD_TEST_REDIS_URL",
        "DOCKER_HOST",
        "TESTCONTAINERS_*"
      ]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    }
  },
  "agentGuidance": false
}
