  "dependencies": {
    "@sold/core": "workspace:*",
    "@sold/db": "workspace:*",
    "@sold/extension-sdk": "workspace:*",
    "@sold/jobs": "workspace:*",
    "commander": "^15.0.0",
    "semver": "^7.8.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sold/config": "workspace:*",
    "@types/semver": "^7.8.0"
  }
}
