{
  "name": "@sold/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The `sold` CLI: environments, releases, upgrades and instance scaffolding",
  "bin": {
    "sold": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
