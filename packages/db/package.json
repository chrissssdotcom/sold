{
  "name": "@sold/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./migrate": "./src/migrate.ts",
    "./lint": "./src/lint/index.ts",
    "./extension-migrations": "./src/extension-migrations.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "migrate": "tsx --env-file-if-exists=../../.env src/cli/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/cli/seed.ts",
    "lint-migrations": "tsx --env-file-if-exists=../../.env src/cli/lint-migrations.ts",
    "generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@libpg-query/parser": "^17.6.10",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@sold/config": "workspace:*",
    "@sold/testing": "workspace:*",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
